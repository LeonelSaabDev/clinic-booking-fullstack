# Copy this file to .env and replace both values. .env is git-ignored: never commit it.

# SQL Server rules: at least 8 characters with upper case, lower case, digits and symbols.
# Avoid ";" because the value is placed inside a connection string.
SQL_SA_PASSWORD=Change-Me-Str0ng!

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-long-random-secret-of-at-least-32-characters
